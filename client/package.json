{
  "name": "client",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "main": "electron/main.js",
  "description": "RatChat desktop client for secure, realtime conversations with your team.",
  "homepage": "https://github.com/K-u-r-c/RatChat",
  "author": {
    "name": "RatChat Team",
    "email": "jakkurc.dev@gmail.com"
  },
  "contributors": [
    {
      "name": "Jakub Kurc (K-u-r-c)",
      "url": "https://github.com/K-u-r-c"
    },
    {
      "name": "Jan Kilar (Naxden)",
      "url": "https://github.com/Naxden"
    }
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "cross-env RATCHAT_DESKTOP=true VITE_DEV_SERVER_URL=https://localhost:3000 concurrently \"npm:dev\" \"npm:electron:wait\"",
    "electron:wait": "wait-on tcp:3000 && electron .",
    "electron:build": "npm run build -- --base=./ && electron-builder --dir",
    "electron:package": "npm run build -- --base=./ && electron-builder"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^6.0.0",
    "@dnd-kit/sortable": "^9.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.2.5",
    "@hookform/resolvers": "^5.1.0",
    "@microsoft/signalr": "^8.0.7",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "@tanstack/react-query": "^5.77.2",
    "@tanstack/react-query-devtools": "^5.77.2",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^4.12.3",
    "linkify-react": "^4.3.2",
    "linkifyjs": "^4.3.2",
    "mobx-react-lite": "^4.1.0",
    "posthog-js": "^1.268.1",
    "react": "^19.1.0",
    "react-cropper": "^2.3.3",
    "react-dom": "^19.1.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.56.4",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^9.16.0",
    "react-router": "^7.6.1",
    "react-toastify": "^11.0.5",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.2",
    "@types/react-cropper": "^1.3.7",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^38.2.1",
    "electron-builder": "^24.13.3",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-mkcert": "^1.17.8",
    "wait-on": "^9.0.1"
  },
  "scripts": {
    "electron:build": "npm run build -- --base=./ && electron-builder --dir --publish=never",
    "electron:package": "npm run build -- --base=./ && electron-builder --publish=never"
  },
  "build": {
    "appId": "com.ratchat.desktop",
    "productName": "RatChat",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "mac": {
      "category": "public.app-category.social-networking",
      "artifactName": "RatChat-${version}.dmg",
      "icon": "electron/resources/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RatChat-Setup-${version}.${ext}",
      "icon": "electron/resources/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "artifactName": "RatChat_${version}_${arch}.${ext}",
      "icon": "electron/resources/icon.png",
      "maintainer": "RatChat Team <jakkurc.dev@gmail.com>"
    }
  }
}
